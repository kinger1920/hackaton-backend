# Vorlage für frontend/.env.local (cp .env.example .env.local) – nur nötig, wenn das Backend
# NICHT unter http://localhost:8000 läuft (z. B. anderer Port oder Deploy-URL).
# Keine Secrets hier: Alles mit VITE_ landet im Browser-Bundle und ist öffentlich sichtbar.
VITE_API_URL=http://localhost:8000
