# Vorlage für backend/.env – so testest du alle Funktionen mit deinem EIGENEN Key:
#   cp backend/.env.example backend/.env   und unten deinen Key eintragen.
# Die echte .env ist in .gitignore und wird NIE committet. Keys nie in Code, Chat oder Screenshots.

# Groq API Key (kostenlos: https://console.groq.com/keys).
# Ohne Key läuft alles im Offline-Modus (Regeln statt KI, Antworten mit "mode": "offline").
GROQ_API_KEY=your-key-here

# Modelle bei Groq (so lassen)
LLM_MODEL=openai/gpt-oss-120b
STT_MODEL=whisper-large-v3

# Optional: Timeout in Sekunden, danach Offline-Fallback
# LLM_TIMEOUT_SECONDS=8

# Optional: Demo-Nutzer für Briefsignatur und Freigabe-Audit (kein Login)
# DEMO_USER_NAME=Bauleiter
# DEMO_COMPANY=Baupartner AG & Co. KG

# Optional: eigene Datenbank statt backend/data/site_assistant.db (die ist im Repo – nicht committen!).
# Wirkt beim Start über ./scripts/dev.sh. Absoluter Pfad mit 4 Schrägstrichen, z. B. für eine Demo-Kopie:
# DATABASE_URL=sqlite:////Users/<du>/bauassist-demo.db

# PDF-Export braucht Pango (macOS: einmal `brew install pango`). Starte den Server mit
# ./scripts/dev.sh – das setzt den Bibliothekspfad. Prüfen: http://localhost:8000/health → "pdf_export": true
